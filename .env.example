# Django Secret Key
SECRET_KEY=django-insecure-emergency-assistant-super-safe-key-2026-prod

# Debug Mode
DEBUG=True

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,*

# OpenAI API Key (Optional: system provides rich RAG fallback if not provided)
OPENAI_API_KEY=

# Google Maps API Key (Optional)
GOOGLE_MAPS_API_KEY=

# Weather API Key (Optional: Open-Meteo free live API is used by default)
WEATHER_API_KEY=

# Database Configuration (PostgreSQL / SQLite fallback)
# Set to 'true' to use PostgreSQL, otherwise SQLite fallback is used
USE_POSTGRES=False
DB_NAME=emergency_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
